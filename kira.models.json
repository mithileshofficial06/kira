{
  "$comment": "Model IDs and prices change often. Run `npm run check-models` to verify IDs; check prices (USD per 1M tokens) in the Mistral console. NIM hosted is free for development. Last verified against the live catalogs 2026-09-24.",
  "providers": {
    "mistral": {
      "baseURL": "https://api.mistral.ai/v1",
      "apiKeyEnv": "MISTRAL_API_KEY",
      "requestsPerMinute": 60
    },
    "nim": {
      "baseURL": "https://integrate.api.nvidia.com/v1",
      "apiKeyEnv": "NVIDIA_API_KEY",
      "requestsPerMinute": 35
    }
  },
  "$roles_comment": "The current Mistral key covers Codestral only (medium/small report a 0 req/min limit). When the plan is upgraded, put mistral-medium-latest first for planner and executor, and mistral-small-latest first for utility.",
  "roles": {
    "planner": [
      {
        "provider": "mistral",
        "model": "codestral-latest"
      },
      {
        "provider": "nim",
        "model": "z-ai/glm-5.3"
      }
    ],
    "executor": [
      {
        "provider": "mistral",
        "model": "codestral-latest"
      },
      {
        "provider": "nim",
        "model": "nvidia/nemotron-3-super-120b-a12b"
      },
      {
        "provider": "nim",
        "model": "z-ai/glm-5.3"
      }
    ],
    "critic": [
      {
        "provider": "nim",
        "model": "z-ai/glm-5.3"
      },
      {
        "provider": "nim",
        "model": "nvidia/nemotron-3-super-120b-a12b"
      },
      {
        "provider": "mistral",
        "model": "codestral-latest"
      }
    ],
    "utility": [
      {
        "provider": "mistral",
        "model": "codestral-latest"
      },
      {
        "provider": "nim",
        "model": "nvidia/nemotron-3-super-120b-a12b"
      }
    ]
  },
  "pricing": {
    "mistral:mistral-medium-latest": {
      "inputPerM": 0.4,
      "outputPerM": 2
    },
    "mistral:codestral-latest": {
      "inputPerM": 0.3,
      "outputPerM": 0.9
    },
    "mistral:mistral-small-latest": {
      "inputPerM": 0.1,
      "outputPerM": 0.3
    },
    "mistral:mistral-embed": {
      "inputPerM": 0.1,
      "outputPerM": 0
    },
    "mistral:codestral-embed": {
      "inputPerM": 0.15,
      "outputPerM": 0
    },
    "nim:z-ai/glm-5.3": {
      "inputPerM": 0,
      "outputPerM": 0
    },
    "nim:nvidia/nemotron-3-super-120b-a12b": {
      "inputPerM": 0,
      "outputPerM": 0
    }
  },
  "memory": {
    "codeEmbed": {
      "provider": "mistral",
      "model": "codestral-embed"
    },
    "textEmbed": {
      "provider": "mistral",
      "model": "mistral-embed"
    },
    "rerank": {
      "provider": "nim",
      "model": "nvidia/llama-nemotron-rerank-vl-1b-v2",
      "url": "https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking"
    }
  }
}

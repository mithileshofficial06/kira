{
  "name": "kira",
  "private": true,
  "version": "0.0.0",
  "description": "Voice-driven autonomous engineering agent for VS Code",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check-models": "npm run check-models -w @kira/daemon",
    "spike": "npm run spike -w @kira/daemon --"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  }
}
